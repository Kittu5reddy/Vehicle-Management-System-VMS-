@startuml VMS_Complete_Architecture_ClassDiagram
!theme plain
title Vehicle Management System - Complete Architecture (All Layers)

' ======================== DOMAIN LAYER ========================
package "1. DOMAIN LAYER (Models)" {
    ' User Hierarchy
    abstract class User {
        -- VARIABLES --
        - id: Integer
        - userName: String
        - role: Role
        - dateOfBirth: LocalDateTime
        - phoneNumber: String
        - fullName: String
        - email: String
        - gender: Gender
        - password: String
        - address: String
        - createdAt: LocalDateTime
        - updatedAt: LocalDateTime
        -- LIFECYCLE --
        # onCreate(): void
        # onUpdate(): void
        -- GETTERS --
        + getId(): Integer
        + getUserName(): String
        + getRole(): Role
        + getDateOfBirth(): LocalDateTime
        + getPhoneNumber(): String
        + getFullName(): String
        + getEmail(): String
        + getGender(): Gender
        + getPassword(): String
        + getAddress(): String
        + getCreatedAt(): LocalDateTime
        + getUpdatedAt(): LocalDateTime
        -- SETTERS --
        + setId(id: Integer): void
        + setUserName(userName: String): void
        + setRole(role: Role): void
        + setDateOfBirth(dateOfBirth: LocalDateTime): void
        + setPhoneNumber(phoneNumber: String): void
        + setFullName(fullName: String): void
        + setEmail(email: String): void
        + setGender(gender: Gender): void
        + setPassword(password: String): void
        + setAddress(address: String): void
        + setCreatedAt(createdAt: LocalDateTime): void
        + setUpdatedAt(updatedAt: LocalDateTime): void
    }

    class Driver {
        -- VARIABLES --
        - licenseNumber: String
        - rating: Float
        - experienceYears: Integer
        - amountPerTrip: Float
        - available: Boolean
        - licenseExpiryDate: LocalDateTime
        -- METHODS --
        + toString(): String
        -- GETTERS --
        + getLicenseNumber(): String
        + getRating(): Float
        + getExperienceYears(): Integer
        + getAmountPerTrip(): Float
        + getAvailable(): Boolean
        + getLicenseExpiryDate(): LocalDateTime
        -- SETTERS --
        + setLicenseNumber(licenseNumber: String): void
        + setRating(rating: Float): void
        + setExperienceYears(experienceYears: Integer): void
        + setAmountPerTrip(amountPerTrip: Float): void
        + setAvailable(available: Boolean): void
        + setLicenseExpiryDate(licenseExpiryDate: LocalDateTime): void
    }

    class Manager {
        -- VARIABLES --
        - salary: Float
        - experienceYears: Integer
        - department: String
        - joiningDate: LocalDateTime
        -- GETTERS --
        + getSalary(): Float
        + getExperienceYears(): Integer
        + getDepartment(): String
        + getJoiningDate(): LocalDateTime
        -- SETTERS --
        + setSalary(salary: Float): void
        + setExperienceYears(experienceYears: Integer): void
        + setDepartment(department: String): void
        + setJoiningDate(joiningDate: LocalDateTime): void
    }

    User <|-- Driver
    User <|-- Manager

    ' Vehicle Hierarchy
    abstract class Vehicle {
        -- VARIABLES --
        - id: Integer
        - brandName: String
        - model: String
        - registrationNumber: String
        - fuelType: FuelType
        - status: VehicleStatus
        - purchaseDate: LocalDateTime
        - createdAt: LocalDateTime
        - updatedAt: LocalDateTime
        -- LIFECYCLE --
        # onCreate(): void
        # onUpdate(): void
        -- GETTERS --
        + getId(): Integer
        + getBrandName(): String
        + getModel(): String
        + getRegistrationNumber(): String
        + getFuelType(): FuelType
        + getStatus(): VehicleStatus
        + getPurchaseDate(): LocalDateTime
        + getCreatedAt(): LocalDateTime
        + getUpdatedAt(): LocalDateTime
        -- SETTERS --
        + setId(id: Integer): void
        + setBrandName(brandName: String): void
        + setModel(model: String): void
        + setRegistrationNumber(registrationNumber: String): void
        + setFuelType(fuelType: FuelType): void
        + setStatus(status: VehicleStatus): void
        + setPurchaseDate(purchaseDate: LocalDateTime): void
        + setCreatedAt(createdAt: LocalDateTime): void
        + setUpdatedAt(updatedAt: LocalDateTime): void
    }

    class Bus {
        -- VARIABLES --
        - seatingCapacity: Integer
        - standingCapacity: Integer
        - busNumber: String
        -- METHODS --
        + toString(): String
        -- GETTERS --
        + getSeatingCapacity(): Integer
        + getStandingCapacity(): Integer
        + getBusNumber(): String
        -- SETTERS --
        + setSeatingCapacity(seatingCapacity: Integer): void
        + setStandingCapacity(standingCapacity: Integer): void
        + setBusNumber(busNumber: String): void
    }

    class Car {
        -- VARIABLES --
        - numberOfDoors: Integer
        - bootSpace: Float
        - hasAC: Boolean
        -- METHODS --
        + toString(): String
        -- GETTERS --
        + getNumberOfDoors(): Integer
        + getBootSpace(): Float
        + getHasAC(): Boolean
        -- SETTERS --
        + setNumberOfDoors(numberOfDoors: Integer): void
        + setBootSpace(bootSpace: Float): void
        + setHasAC(hasAC: Boolean): void
    }

    class Truck {
        -- VARIABLES --
        - loadCapacity: Float
        - numberOfAxles: Integer
        - truckType: TruckType
        -- CONSTRUCTOR --
        + Truck()
        -- METHODS --
        + toString(): String
        -- GETTERS --
        + getLoadCapacity(): Float
        + getNumberOfAxles(): Integer
        + getTruckType(): TruckType
        -- SETTERS --
        + setLoadCapacity(loadCapacity: Float): void
        + setNumberOfAxles(numberOfAxles: Integer): void
        + setTruckType(truckType: TruckType): void
    }

    Vehicle <|-- Bus
    Vehicle <|-- Car
    Vehicle <|-- Truck

    ' Transactions
    class Trip {
        -- VARIABLES --
        - id: Integer
        - vehicle: Vehicle
        - driver: Driver
        - startLocation: String
        - endLocation: String
        - startTime: LocalDateTime
        - endTime: LocalDateTime
        - distance: Float
        - status: TripStatus
        - createdAt: LocalDateTime
        - updatedAt: LocalDateTime
        -- GETTERS --
        + getId(): Integer
        + getVehicle(): Vehicle
        + getDriver(): Driver
        + getStartLocation(): String
        + getEndLocation(): String
        + getStartTime(): LocalDateTime
        + getEndTime(): LocalDateTime
        + getDistance(): Float
        + getStatus(): TripStatus
        + getCreatedAt(): LocalDateTime
        + getUpdatedAt(): LocalDateTime
        -- SETTERS --
        + setId(id: Integer): void
        + setVehicle(vehicle: Vehicle): void
        + setDriver(driver: Driver): void
        + setStartLocation(startLocation: String): void
        + setEndLocation(endLocation: String): void
        + setStartTime(startTime: LocalDateTime): void
        + setEndTime(endTime: LocalDateTime): void
        + setDistance(distance: Float): void
        + setStatus(status: TripStatus): void
        + setCreatedAt(createdAt: LocalDateTime): void
        + setUpdatedAt(updatedAt: LocalDateTime): void
    }

    class Maintenance {
        -- VARIABLES --
        - id: Integer
        - vehicle: Vehicle
        - serviceType: String
        - description: String
        - serviceDate: LocalDateTime
        - cost: Double
        - serviceCenter: String
        -- GETTERS --
        + getId(): Integer
        + getVehicle(): Vehicle
        + getServiceType(): String
        + getDescription(): String
        + getServiceDate(): LocalDateTime
        + getCost(): Double
        + getServiceCenter(): String
        -- SETTERS --
        + setId(id: Integer): void
        + setVehicle(vehicle: Vehicle): void
        + setServiceType(serviceType: String): void
        + setDescription(description: String): void
        + setServiceDate(serviceDate: LocalDateTime): void
        + setCost(cost: Double): void
        + setServiceCenter(serviceCenter: String): void
    }

    Trip --> Vehicle
    Trip --> Driver
    Maintenance --> Vehicle
}

' ======================== DAO LAYER ========================
package "2. DAO LAYER (Data Access)" {
    interface VehicleDao {
        + findById(id: Integer): Vehicle
        + save(vehicle: Vehicle): void
        + findAll(): List<Vehicle>
        + update(vehicle: Vehicle): void
        + delete(id: Integer): void
    }

    interface DriverDao {
        + save(driver: Driver): void
        + findById(id: Integer): Driver
        + findAll(): List<Driver>
        + findAllAvailableDrivers(): List<Driver>
        + update(driver: Driver): void
        + delete(id: Integer): void
    }

    interface TripDao {
        + save(trip: Trip): void
        + findById(id: Integer): Trip
        + findAll(): List<Trip>
        + update(trip: Trip): void
        + delete(id: Integer): void
    }

    interface MaintenanceDao {
        + save(maintenance: Maintenance): void
        + findById(id: Integer): Maintenance
        + findAll(): List<Maintenance>
        + update(maintenance: Maintenance): void
        + delete(id: Integer): void
    }

    interface UserDao {
        + findByUserName(userName: String): User
        + save(user: User): void
        + findById(id: Integer): User
        + findAll(): List<User>
        + update(user: User): void
        + delete(id: Integer): void
    }

    class VehicleDaoImpl {
        - vehicleDao: VehicleDao
        + findById(id: Integer): Vehicle
        + save(vehicle: Vehicle): void
        + findAll(): List<Vehicle>
        + update(vehicle: Vehicle): void
        + delete(id: Integer): void
    }

    class DriverDaoImpl {
        - driverDao: DriverDao
        + save(driver: Driver): void
        + findById(id: Integer): Driver
        + findAll(): List<Driver>
        + findAllAvailableDrivers(): List<Driver>
        + update(driver: Driver): void
        + delete(id: Integer): void
    }

    class TripDaoImpl {
        - tripDao: TripDao
        + save(trip: Trip): void
        + findById(id: Integer): Trip
        + findAll(): List<Trip>
        + update(trip: Trip): void
        + delete(id: Integer): void
    }

    class MaintenanceDaoImpl {
        - maintenanceDao: MaintenanceDao
        + save(maintenance: Maintenance): void
        + findById(id: Integer): Maintenance
        + findAll(): List<Maintenance>
        + update(maintenance: Maintenance): void
        + delete(id: Integer): void
    }

    class UserDaoImpl {
        - userDao: UserDao
        + findByUserName(userName: String): User
        + save(user: User): void
        + findById(id: Integer): User
        + findAll(): List<User>
        + update(user: User): void
        + delete(id: Integer): void
    }

    VehicleDao <|.. VehicleDaoImpl
    DriverDao <|.. DriverDaoImpl
    TripDao <|.. TripDaoImpl
    MaintenanceDao <|.. MaintenanceDaoImpl
    UserDao <|.. UserDaoImpl

    VehicleDaoImpl --> Vehicle
    DriverDaoImpl --> Driver
    TripDaoImpl --> Trip
    MaintenanceDaoImpl --> Maintenance
    UserDaoImpl --> User
}

' ======================== SERVICE LAYER ========================
package "3. SERVICE LAYER (Business Logic)" {
    interface VehicleService {
        + saveVehicle(vehicle: Vehicle): void
        + getVehicleById(id: Integer): Vehicle
        + getAllVehicles(): List<Vehicle>
        + updateVehicle(vehicle: Vehicle): void
        + deleteVehicle(id: Integer): void
    }

    interface DriverService {
        + saveDriver(driver: Driver): void
        + getDriverById(id: Integer): Driver
        + getAllDrivers(): List<Driver>
        + getAvailableDrivers(): List<Driver>
        + updateDriver(driver: Driver): void
        + deleteDriver(id: Integer): void
    }

    interface TripService {
        + saveTrip(trip: Trip): void
        + getTripById(id: Integer): Trip
        + getAllTrips(): List<Trip>
        + updateTrip(trip: Trip): void
        + deleteTrip(id: Integer): void
    }

    interface MaintenanceService {
        + saveMaintenance(maintenance: Maintenance): void
        + getMaintenanceById(id: Integer): Maintenance
        + getAllMaintenances(): List<Maintenance>
        + updateMaintenance(maintenance: Maintenance): void
        + deleteMaintenance(id: Integer): void
    }

    interface AuthService {
        + login(userName: String, password: String): User
        + logout(): void
    }

    class VehicleServiceImpl {
        - vehicleDao: VehicleDao
        + VehicleServiceImpl()
        + saveVehicle(vehicle: Vehicle): void
        + getVehicleById(id: Integer): Vehicle
        + getAllVehicles(): List<Vehicle>
        + updateVehicle(vehicle: Vehicle): void
        + deleteVehicle(id: Integer): void
    }

    class DriverServiceImpl {
        - driverDao: DriverDao
        + DriverServiceImpl()
        + saveDriver(driver: Driver): void
        + getDriverById(id: Integer): Driver
        + getAllDrivers(): List<Driver>
        + getAvailableDrivers(): List<Driver>
        + updateDriver(driver: Driver): void
        + deleteDriver(id: Integer): void
    }

    class TripServiceImpl {
        - tripDao: TripDao
        + TripServiceImpl()
        + saveTrip(trip: Trip): void
        + getTripById(id: Integer): Trip
        + getAllTrips(): List<Trip>
        + updateTrip(trip: Trip): void
        + deleteTrip(id: Integer): void
    }

    class MaintenanceServiceImpl {
        - maintenanceDao: MaintenanceDao
        + MaintenanceServiceImpl()
        + saveMaintenance(maintenance: Maintenance): void
        + getMaintenanceById(id: Integer): Maintenance
        + getAllMaintenances(): List<Maintenance>
        + updateMaintenance(maintenance: Maintenance): void
        + deleteMaintenance(id: Integer): void
    }

    class AuthServiceImpl {
        - userDao: UserDao
        + AuthServiceImpl()
        + login(userName: String, password: String): User
        + logout(): void
    }

    VehicleService <|.. VehicleServiceImpl
    DriverService <|.. DriverServiceImpl
    TripService <|.. TripServiceImpl
    MaintenanceService <|.. MaintenanceServiceImpl
    AuthService <|.. AuthServiceImpl

    VehicleServiceImpl --> VehicleDao
    VehicleServiceImpl --> Vehicle
    DriverServiceImpl --> DriverDao
    DriverServiceImpl --> Driver
    TripServiceImpl --> TripDao
    TripServiceImpl --> Trip
    MaintenanceServiceImpl --> MaintenanceDao
    MaintenanceServiceImpl --> Maintenance
    AuthServiceImpl --> UserDao
    AuthServiceImpl --> User
}

' ======================== CONTROLLER LAYER ========================
package "4. CONTROLLER LAYER (Application Logic)" {
    class AuthController {
        - authService: AuthService
        - mainFrame: MainFrame
        + AuthController(mainFrame: MainFrame)
        + login(username: String, password: String): void
        + logout(): void
    }

    class VehicleController {
        - vehicleService: VehicleService
        - view: VehiclesPanel
        + VehicleController(view: VehiclesPanel)
        + loadVehicles(): void
        + updateVehicle(id: Integer, number: String, brand: String, model: String, fuel: String, status: String, purchaseDate: String): void
    }

    class DriverController {
        - view: DriversPanel
        - driverService: DriverService
        + DriverController(view: DriversPanel)
        + loadDrivers(): void
        + createDriver(fullName: String, userName: String, password: String, licenseNumber: String, ...): void
    }

    class TripController {
        - tripService: TripService
        - view: TripsPanel
        + TripController(view: TripsPanel)
        + loadTrips(): void
        + createTrip(tripData: Map): void
    }

    class MaintenanceController {
        - maintenanceService: MaintenanceService
        - view: MaintenancePanel
        + MaintenanceController(view: MaintenancePanel)
        + loadMaintenances(): void
        + scheduleMaintenance(maintenanceData: Map): void
    }

    class DashboardController {
        - vehicleService: VehicleService
        - driverService: DriverService
        - tripService: TripService
        - maintenanceService: MaintenanceService
        - view: DashboardPanel
        + DashboardController(view: DashboardPanel)
        + loadDashboardStats(): void
        + updateStats(): void
    }

    AuthController --> AuthService
    AuthController --> MainFrame
    VehicleController --> VehicleService
    VehicleController --> VehiclesPanel
    DriverController --> DriverService
    DriverController --> DriversPanel
    TripController --> TripService
    TripController --> TripsPanel
    MaintenanceController --> MaintenanceService
    MaintenanceController --> MaintenancePanel
    DashboardController --> VehicleService
    DashboardController --> DriverService
    DashboardController --> TripService
    DashboardController --> MaintenanceService
    DashboardController --> DashboardPanel
}

' ======================== PRESENTATION LAYER ========================
package "5. PRESENTATION LAYER (UI Components)" {
    interface Renderable {
        + render(): void
        + refresh(): void
    }

    class LoginFrame {
        - txtUser: JTextField
        - txtPass: JPasswordField
        - authController: AuthController
        + LoginFrame(authController: AuthController)
        - createIcon(width: int, height: int): ImageIcon
        - setupListeners(): void
    }

    class MainFrame {
        - cardLayout: CardLayout
        - cardPanel: JPanel
        - authController: AuthController
        - mainFrame: MainFrame
        + MainFrame()
        + showCard(cardName: String): void
        + openAdminDashboard(user: User): void
        + openDriverDashboard(user: User): void
    }

    class DashboardPanel {
        - vehiclesLabel: JLabel
        - driversLabel: JLabel
        - tripsLabel: JLabel
        - maintenanceLabel: JLabel
        - recentTripsContainer: JPanel
        - maintenanceContainer: JPanel
        - controller: DashboardController
        + DashboardPanel()
        - createStatCard(title: String, label: JLabel): JPanel
        - createDynamicListCard(title: String): JPanel
        + updateStats(stats: Map): void
    }

    class VehiclesPanel {
        - model: DefaultTableModel
        - table: JTable
        - controller: VehicleController
        + VehiclesPanel()
        + clearTable(): void
        + addVehicleRow(data: Object[]): void
        + deleteVehicle(vehicleId: Integer): void
    }

    class DriversPanel {
        - model: DefaultTableModel
        - table: JTable
        - controller: DriverController
        + DriversPanel()
        + clearTable(): void
        + addDriverRow(data: Object[]): void
        + deleteDriver(driverId: Integer): void
    }

    class TripsPanel {
        - model: DefaultTableModel
        - table: JTable
        - controller: TripController
        + TripsPanel()
        + clearTable(): void
        + addTripRow(data: Object[]): void
        + deleteTrip(tripId: Integer): void
    }

    class MaintenancePanel {
        - model: DefaultTableModel
        - table: JTable
        - controller: MaintenanceController
        + MaintenancePanel()
        + clearTable(): void
        + addMaintenanceRow(data: Object[]): void
        + deleteMaintenanceRecord(recordId: Integer): void
    }

    class ProfilePanel {
        - controller: AuthController
        + ProfilePanel()
        + displayUserProfile(user: User): void
        + updateProfile(userData: Map): void
    }

    class Sidebar {
        - buttons: List<JButton>
        + Sidebar()
        + selectButton(buttonName: String): void
        + onNavigationClick(listener: NavigationListener): void
    }

    class Theme {
        + {static} CARD_BG: Color
        + {static} TEXT_COLOR: Color
        + {static} PRIMARY_COLOR: Color
        + {static} SECONDARY_COLOR: Color
        + {static} cardPanel(): JPanel
        + {static} styleButtonPrimary(button: JButton): void
        + {static} styleButtonSecondary(button: JButton): void
        + {static} createIcon(width: int, height: int): BufferedImage
    }

    Renderable <|.. LoginFrame
    Renderable <|.. DashboardPanel
    Renderable <|.. VehiclesPanel
    Renderable <|.. DriversPanel
    Renderable <|.. TripsPanel
    Renderable <|.. MaintenancePanel

    LoginFrame --> AuthController
    MainFrame --> AuthController
    DashboardPanel --> DashboardController
    VehiclesPanel --> VehicleController
    DriversPanel --> DriverController
    TripsPanel --> TripController
    MaintenancePanel --> MaintenanceController
    ProfilePanel --> AuthController
    Theme --> MainFrame
    MainFrame --> LoginFrame
    MainFrame --> DashboardPanel
}

' ======================== ENUMS ========================
package "Enums" {
    enum Role {
        MANAGER
        DRIVER
        ADMIN
    }

    enum Gender {
        MALE
        FEMALE
        OTHER
    }

    enum FuelType {
        PETROL
        DIESEL
        HYBRID
        ELECTRIC
    }

    enum VehicleStatus {
        ACTIVE
        INACTIVE
        MAINTENANCE
        RETIRED
    }

    enum TripStatus {
        SCHEDULED
        IN_PROGRESS
        COMPLETED
        CANCELLED
    }

    enum TruckType {
        FLATBED
        BOX
        TANKER
        CONTAINER
    }

    User --> Role
    User --> Gender
    Vehicle --> FuelType
    Vehicle --> VehicleStatus
    Trip --> TripStatus
    Truck --> TruckType
}

' ======================== UTILITY & CONFIG ========================
package "Utilities & Configuration" {
    class HibernateUtil {
        - sessionFactory: SessionFactory
        + {static} getSessionFactory(): SessionFactory
        + {static} getSession(): Session
    }

    class PasswordUtil {
        + {static} hashPassword(password: String): String
        + {static} checkPassword(password: String, hash: String): Boolean
    }

    class AppSession {
        - {static} instance: AppSession
        - currentUser: User
        + {static} getInstance(): AppSession
        + setUser(user: User): void
        + getUser(): User
        + clear(): void
    }
}

' ======================== LEGEND ========================
legend right
    |<#DDDDFF> Domain Layer (Models) |
    |<#DDFFDD> DAO Layer (Data Access) |
    |<#FFDDDD> Service Layer (Business Logic) |
    |<#FFFFDD> Controller Layer (Application Logic) |
    |<#DDFFFF> Presentation Layer (UI) |
    |<#FFFFBB> Utilities & Configuration |
    |<#CCCCCC> Enums |
endlegend

@enduml
